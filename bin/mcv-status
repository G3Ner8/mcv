#!/usr/bin/env bash
#
# mcv-status: a worker's status log, and the text mcv's hooks give a worker.
#
# A worker (a Claude Code session with MCV_TASK=<project>/<id> set) reports:
#   mcv-status needs-decision <text>   ask the user a question; prints its id (q1, q2, ...)
#   mcv-status blocked <text>          cannot continue
#   mcv-status done <text>             the task is finished
#   mcv-status failed <text>           giving up, with the reason
#   mcv-status note <text>             progress worth knowing; needs no answer and
#                                      wakes nobody (status table only)
#   mcv-status waiting <text>          about to end a turn to wait for background
#                                      work it started; that stop wakes nobody
#                                      unless it lasts (see mcv-watch)
# Quote the text; several words given without quotes are joined with spaces.
# Empty text is refused (exit 2), as is an empty answer.
#
# The coordinator records an answer, which closes the question:
#   mcv-status --task <project>/<id> answered <question-id> <text>
# or, when the worker was still busy and the answer could not be sent yet,
# keeps it for later; mcv-watch prints it as a deliver event once the worker
# stops, and the question stays open until answered:
#   mcv-status --task <project>/<id> pending <question-id> <text>
# An order that answers no question, given while the worker is busy, is kept
# the same way under a new order id, which is printed (o1, o2, ...):
#   mcv-status --task <project>/<id> pending - <text>
# An order id then works where a question id does: pending o<n> again after a
# refused send, answered o<n> once it is sent.
# An answer sent and then corrected (the user meant something else) is
# recorded, after the correction is sent, as
#   mcv-status --task <project>/<id> amended <question-id> <text>
# which needs an answered line first and may be repeated.
# (all three refused when MCV_TASK is set: a worker never closes its own questions)
#
# The coordinator adds a line to the project's journal, next to the ones
# mcv-herdr.sh writes, for something worth looking at after the run
# (refused for a worker, which reports with note):
#   mcv-status --journal <project>[/<id>] <text>
# into ${MCV_HOME:-~/.claude/mcv}/<project>/journal.log as
#   <UTC time>\tnote\t<project>/<id> or -\t<text, cleaned as below>
#
# mcv's hooks call:
#   mcv-status --contract              SessionStart: the rules a worker follows;
#                                      also leaves <task>/rules-loaded, and adds
#                                      the session's transcript path to
#                                      <task>/transcripts
#   mcv-status --deny-ask              PreToolUse on AskUserQuestion: refuse it
#   mcv-status --guard-git             PreToolUse on Bash: refuse a git command
#                                      that pushes to a branch other than the
#                                      worker's, force-pushes (--force-with-lease
#                                      only on its own branch), or deletes or
#                                      moves another branch or a tag; reads the
#                                      command's text, so a script or alias
#                                      gets past it
# Each prints nothing and exits 0 unless MCV_TASK names a task that exists.
#
# Each event is one line in ${MCV_HOME:-~/.claude/mcv}/<project>/tasks/<id>/status.log:
#   <UTC time>\t<kind>\t<question id or ->\t<text, tabs and newlines turned into spaces,
#   terminal escape sequences and other control characters removed>
#
# Exit: 0 ok; 1 error (bad MCV_TASK or unknown task, unknown or already
# answered question);
# 2 usage (unknown kind, or a worker kind without MCV_TASK).

set -euo pipefail

MCV_HOME="${MCV_HOME:-$HOME/.claude/mcv}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

die()   { printf 'mcv-status: %s\n' "$*" >&2; exit 1; }
usage() { printf 'mcv-status: %s\n' "$*" >&2; exit 2; }

TASK_RE='^[a-z][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$'

# True when "<project>/<id>" names a task spawn created (its meta exists).
is_task() {
  [[ "$1" =~ $TASK_RE && -f "$MCV_HOME/${1%%/*}/tasks/${1#*/}/meta" ]]
}

# Turn "<project>/<id>" into its log path; die unless it is a task.
log_of() {
  local task="$1"
  [[ "$task" =~ $TASK_RE ]] || die "expected <project>/<id>, got '$task'"
  is_task "$task" || die "no task '$task' (nothing at $MCV_HOME/${task%%/*}/tasks/${task#*/}/meta)"
  printf '%s/%s/tasks/%s/status.log' "$MCV_HOME" "${task%%/*}" "${task#*/}"
}

# Every write to a log holds its lock, so question numbers never repeat, a
# question is answered once, and long lines never interleave.
#
# The lock holds "<pid> <epoch seconds>". A holder that exits normally
# releases it first, so a lock outliving its pid was left by a crash and is
# taken over. Checking only the pid is not enough: between reading it and
# deleting the lock, that holder can release and another writer take the
# lock, which would then be deleted. So the lock is taken over only if it is
# unchanged since it was read and at least 2 seconds old, and only under a
# second lock (see takeover).
#
# Two writers that both found the lock stale could otherwise each delete it:
# the first deletes it and makes its own, the second, which checked before
# that, deletes the first one's new lock, and both write at once (measured:
# repeated question ids in most rounds of 12 writers on a stale lock).
# takeover holds <lock>.takeover while it checks again, deletes and makes
# the lock, and writes its pid before letting go, so the next writer in sees
# a live holder. A takeover lock left by a writer killed mid-takeover is
# cleared the same way a stale lock is noticed: its pid has exited and it
# is at least 2 seconds old, or it has no pid and is a minute old.
takeover() {
  local l="$1" seen="$2" t="$1.takeover" tseen tpid tat ok=1
  if ! mkdir "$t" 2>/dev/null; then
    tseen="$(cat "$t/pid" 2>/dev/null || true)"
    read -r tpid tat <<<"$tseen" || true
    if [[ "$tpid" =~ ^[0-9]+$ && "$tat" =~ ^[0-9]+$ ]] && (( $(date +%s) - tat >= 2 )) \
      && ! kill -0 "$tpid" 2>/dev/null; then
      rm -rf "$t"
    elif [[ -z "$tseen" && -n "$(find "$t" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
      rm -rf "$t"
    fi
    return 1
  fi
  printf '%s %s\n' "$$" "$(date +%s)" >"$t/pid"
  if [[ "$(cat "$l/pid" 2>/dev/null || true)" == "$seen" ]]; then
    rm -rf "$l"
    if mkdir "$l" 2>/dev/null; then
      printf '%s %s\n' "$$" "$(date +%s)" >"$l/pid"
      ok=0
    fi
  fi
  rm -rf "$t"
  return "$ok"
}

LOCK=""
lock_log() {
  local l="$1.lock" seen pid at now i=0
  until mkdir "$l" 2>/dev/null; do
    seen="$(cat "$l/pid" 2>/dev/null || true)"
    read -r pid at <<<"$seen" || true
    now="$(date +%s)"
    if [[ "$pid" =~ ^[0-9]+$ && "$at" =~ ^[0-9]+$ ]] && (( now - at >= 2 )) \
      && ! kill -0 "$pid" 2>/dev/null \
      && [[ "$(cat "$l/pid" 2>/dev/null || true)" == "$seen" ]]; then
      takeover "$l" "$seen" && break
    fi
    (( i++ < 200 )) || die "the status log is locked ($l); delete it if no mcv-status is running"
    sleep 0.05
  done
  LOCK="$l"
  trap 'rm -rf "$LOCK"' EXIT
  printf '%s %s\n' "$$" "$(date +%s)" >"$l/pid"
  # A writer killed mid-line, or an old log, can end without a newline; the
  # next line would join it, and a question would hide inside another line.
  if [[ -s "$1" && -n "$(tail -c 1 "$1")" ]]; then
    printf '\n' >>"$1"
  fi
}

# Print text $1 as it goes into the log: one line, no control characters.
clean() {
  local text="$1"
  text="${text//$'\r'/ }"
  text="${text//$'\n'/ }"
  text="${text//$'\t'/ }"
  # Other control characters (a terminal escape, say) would reach the
  # coordinator's screen as they are. Escape sequences go whole first, or
  # "[31m" would stay: CSI such as a colour (parameters may start with a
  # private prefix like > or ?), the same with the C1 introducer U+009B, OSC
  # such as a window title, then any other ESC sequence such as the charset
  # designation ESC ( B. U+009B is matched as its two UTF-8 bytes, never as a
  # lone 9B byte, which also ends ordinary characters such as Thai U+0E1B.
  text="$(printf '%s' "$text" \
    | LC_ALL=C sed -E \
      -e $'s/\e\\[[0-?]*[ -/]*[@-~]//g' \
      -e $'s/\xc2\x9b[0-?]*[ -/]*[@-~]//g' -e $'s/\xc2\x9b//g' \
      -e $'s/\e\\][^\a\e]*(\a|\e\\\\)//g' \
      -e $'s/\e[ -/]*[0-~]//g' \
    | LC_ALL=C tr -d '\000-\010\013-\037\177')"
  printf '%s' "$text"
}

# Append one event as one line.
append() {
  printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" "$3" "$(clean "$4")" >>"$1"
}

# True when text $1 still says something once cleaned.
has_text() { [[ "$(clean "$1")" =~ [^[:space:]] ]]; }

contract_text() {
  local meta branch context repo parent context_rule=""
  meta="$MCV_HOME/${MCV_TASK%%/*}/tasks/${MCV_TASK#*/}/meta"
  branch="$(jq -r '.branch // empty' "$meta" 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then branch="\`$branch\`"; else branch="the branch you started on"; fi
  context="$(jq -r '.context // empty' "$meta" 2>/dev/null || true)"
  if [[ -n "$context" ]]; then
    context_rule="
- $context is the project around this repository, opened for you to read: its CLAUDE.md, its skills, its plans. Never write, move or delete anything there, and never run git in it or in any repository inside it."
    # Notes written for the main checkout reach the project with ../, which
    # from a worktree elsewhere points at nothing.
    repo="$(jq -r '.repo // empty' "$meta" 2>/dev/null || true)"
    parent="$(cd "$(dirname "${repo:-/nonexistent/x}")" 2>/dev/null && pwd -P || true)"
    if [[ -n "$repo" && "$parent" == "$context" ]]; then
      context_rule="$context_rule
- Instructions written for the main checkout $repo may use ../<path>; from this worktree that means $context/<path>."
    fi
  fi
  cat <<EOF
You are an mcv worker for task $MCV_TASK. A coordinator session started you and passes your questions to the user.

Report through mcv-status, by its full path:
  "$SELF" needs-decision "<question>"   when you need the user to choose; it prints the question id
  "$SELF" blocked "<why>"               when you cannot continue
  "$SELF" done "<one-line summary>"     when the task is finished
  "$SELF" failed "<reason>"             when you are giving up
  "$SELF" note "<progress>"             for progress worth knowing that needs no answer
  "$SELF" waiting "<what, how long>"    just before you end a turn to wait for background work

Rules:
- Never use the AskUserQuestion tool. Ask through needs-decision instead. This overrides any skill or instruction that tells you to ask the user.
- After needs-decision, end your turn and wait. The answer arrives as your next prompt.
- One decision per needs-decision. Two things to decide are two calls, so the user can answer each by its id. Say which option you recommend.
- Each time you end a turn to wait for background work (a sub-agent, a build, a Monitor), run waiting first. A turn that ends with no report reads as a stop, and the coordinator then reads your screen.
- A note only goes to the coordinator's status table and wakes nobody. Send one at a milestone, not at every step.
- Work only in this worktree, your current directory. Never touch the repository's main checkout.$context_rule
- If the user types into this window directly, that outranks the coordinator. Even then, ask through needs-decision or in plain text, never AskUserQuestion: it is blocked for workers.

Git, always (mcv's floor, whatever else applies):
- Work only on $branch. Never commit to, push to, or merge into any other branch, and never to main, master, develop or a protected branch.
- Never force-push; on your own branch, --force-with-lease only.
- Never commit secrets (.env files, tokens, keys).

Git, everything else: follow this project's own git rules (CLAUDE.md, CONTRIBUTING) where they exist; they win. Where they say nothing:
- Small commits, one change each, in Conventional Commits form ("fix: add oat-milk surcharge to cart total"), imperative, subject at most 72 characters.
- Run the project's tests and linters before committing, if it has them.
- Before handing in, rebase onto the latest base branch.
- Finish by pushing your branch and opening a draft pull or merge request that says what changed, why, and how it was tested; then report done.
EOF
}

# The git guard. The worker's git rules are text in its context; a worker in
# auto mode runs them unattended, and every worktree shares the repository's
# refs, so a slip (a push to develop, a branch -D) reaches the user's own
# branches. This checks each Bash command for the few git commands that reach
# past the worker's branch and refuses them before they run.
#
# It reads the command's text, with its redirections removed, split at
# ; & | ( ) ` { } and newlines, with quotes dropped, and looks at each piece
# that starts with git. It catches mistakes, not a worker set on getting around it: a script, an alias or a
# variable hides the command from it. A quoted message holding such a command
# ("git commit -m 'then git push -f'") is refused too; reword it.

# Print why the git command in words $3... must not run, or nothing. $1 is
# the folder it runs in, $2 the worker's branch.
git_reason() {
  local dir="$1" own="$2"
  shift 2
  while [[ $# -gt 0 && ( "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*= || "$1" == env || "$1" == command \
    || "$1" == exec || "$1" == sudo || "$1" == nohup ) ]]; do shift; done
  [[ $# -gt 0 && ( "$1" == git || "$1" == */git ) ]] || return 0
  shift
  while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
      -C)
        if [[ "${2:-}" == /* ]]; then dir="${2:-}"; else dir="$dir/${2:-}"; fi
        shift 2 || return 0 ;;
      -c|--git-dir|--work-tree|--namespace|--config-env) shift 2 || return 0 ;;
      *) shift ;;
    esac
  done
  local sub="${1:-}"
  shift || true
  case "$sub" in
    push)       push_reason "$dir" "$own" "$@" ;;
    branch)     branch_reason "$own" "$@" ;;
    tag)        tag_reason "$@" ;;
    update-ref) update_ref_reason "$own" "$@" ;;
    checkout|switch) reset_branch_reason "$own" "$@" ;;
  esac
}

# The branch checked out in folder $1, or nothing (not a repository, or a
# detached HEAD, where git refuses a push of HEAD by itself).
current_branch() { git -C "$1" branch --show-current 2>/dev/null || true; }

push_reason() {
  local dir="$1" own="$2" force="" del="" w
  shift 2
  local -a pos=()
  while [[ $# -gt 0 ]]; do
    w="$1"
    case "$w" in
      --force|--force-if-includes) force=1 ;;
      --force-with-lease|--force-with-lease=*) ;;
      --delete) del=1 ;;
      --all|--branches|--mirror|--tags)
        printf '%s pushes every branch or tag, not only your branch' "$w"; return ;;
      --prune) printf -- '--prune deletes branches on the remote'; return ;;
      -o|--push-option|--repo|--receive-pack|--exec) shift ;;
      --) shift; pos+=("$@"); break ;;
      --*) ;;
      -*)
        [[ "$w" != *f* ]] || force=1
        [[ "$w" != *d* ]] || del=1 ;;
      *) pos+=("$w") ;;
    esac
    shift
  done
  [[ -z "$force" ]] || { printf 'never force-push; on your own branch use --force-with-lease'; return; }
  local cur
  # No refspec: git pushes the branch checked out there.
  if [[ ${#pos[@]} -le 1 ]]; then
    cur="$(current_branch "$dir")"
    [[ -z "$cur" || "$cur" == "$own" ]] || printf 'this pushes %s, which is checked out there, not your branch' "$cur"
    return
  fi
  local r src dst
  for r in "${pos[@]:1}"; do
    if [[ "$r" == +* ]]; then printf 'a + refspec (%s) force-pushes' "$r"; return; fi
    if [[ -n "$del" ]]; then dst="$r"
    elif [[ "$r" == *:* ]]; then src="${r%%:*}"; dst="${r#*:}"
    else src="$r"; dst="$r"
    fi
    [[ -n "$dst" ]] || dst="$src"
    if [[ "$dst" == HEAD || "$dst" == @ ]]; then
      cur="$(current_branch "$dir")"
      [[ -z "$cur" || "$cur" == "$own" ]] || { printf 'HEAD there is %s, not your branch' "$cur"; return; }
      continue
    fi
    dst="${dst#refs/heads/}"
    [[ "$dst" == "$own" ]] && continue
    if [[ -n "$del" || "$r" == :* ]]; then printf 'this deletes %s on the remote' "$dst"
    else printf 'this pushes to %s' "$dst"
    fi
    return
  done
}

branch_reason() {
  local own="$1" mode="" force="" remote="" w
  shift
  local -a names=()
  while [[ $# -gt 0 ]]; do
    w="$1"
    case "$w" in
      -d|-D|--delete) mode=delete ;;
      -m|-M|--move) mode=move ;;
      -C) mode=copy-force ;;
      -f|--force) force=1 ;;
      -r|--remotes) remote=1 ;;
      -u|--set-upstream-to|--contains|--no-contains|--merged|--no-merged|--points-at|--sort|--format) shift ;;
      --*) ;;
      -*)
        [[ "$w" != *[dD]* ]] || mode=delete
        [[ "$w" != *[mM]* ]] || mode=move
        [[ "$w" != *r* ]] || remote=1
        [[ "$w" != *f* ]] || force=1 ;;
      *) names+=("$w") ;;
    esac
    shift
  done
  local n
  case "$mode" in
    delete)
      [[ -z "$remote" ]] || return 0
      for n in ${names[@]+"${names[@]}"}; do
        [[ "$n" == "$own" ]] || { printf 'this deletes branch %s' "$n"; return; }
      done ;;
    move) printf 'this renames a branch; mcv knows yours as %s' "$own" ;;
    copy-force) printf 'branch -C overwrites the branch it copies to' ;;
    *)
      if [[ -n "$force" && ${#names[@]} -gt 0 && "${names[0]}" != "$own" ]]; then
        printf 'this moves branch %s' "${names[0]}"
      fi ;;
  esac
}

tag_reason() {
  local w
  for w in "$@"; do
    case "$w" in
      -d|--delete) printf 'this deletes a tag'; return ;;
      -f|--force) printf 'this moves a tag'; return ;;
      --*) ;;
      -*)
        [[ "$w" != *d* ]] || { printf 'this deletes a tag'; return; }
        [[ "$w" != *f* ]] || { printf 'this moves a tag'; return; } ;;
    esac
  done
}

update_ref_reason() {
  local own="$1" w
  shift
  for w in "$@"; do
    [[ "$w" == -* ]] && continue
    [[ "$w" == "refs/heads/$own" || "$w" != refs/heads/* && "$w" != refs/tags/* ]] \
      || printf 'this changes %s' "$w"
    return
  done
}

reset_branch_reason() {
  local own="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -B|-C|--force-create)
        [[ "${2:-}" == "$own" ]] || printf 'this resets branch %s' "${2:-}"
        return ;;
    esac
    shift
  done
}

# Print command text $1 without its redirections (2>&1, >file, 2> file, &>file,
# <file, here-documents and here-strings), so that the split below neither
# cuts 2>&1 at its & nor leaves "2>" or a log file behind as a push target.
# A number counts as a file descriptor only as a word of its own, as in the
# shell: in main2>log the word is main2.
strip_redirects() {
  local w='[^[:space:];&|()<>]+'
  printf '%s\n' "$1" | sed -E \
    -e 's/(^|[[:space:]])[0-9]*>&[0-9]*-?/\1/g' \
    -e "s/&>>?[[:space:]]*$w//g" \
    -e "s/<<<[[:space:]]*$w//g" \
    -e "s/<<-?[[:space:]]*$w//g" \
    -e "s/(^|[[:space:]])[0-9]*(>>|>\\||>|<)[[:space:]]*$w/\\1/g" \
    -e "s/(>>|>\\||>|<)[[:space:]]*$w//g"
}

guard_git() {
  local input cmd cwd own seg reason
  input="$(cat)"
  cmd="$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null || true)"
  [[ "$cmd" == *git* ]] || return 0
  cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null || true)"
  [[ -n "$cwd" ]] || cwd="$PWD"
  own="$(jq -r '.branch // empty' "$MCV_HOME/${MCV_TASK%%/*}/tasks/${MCV_TASK#*/}/meta" 2>/dev/null || true)"
  [[ -n "$own" ]] || return 0
  cmd="$(strip_redirects "$cmd")"
  cmd="${cmd//&&/$'\n'}"
  cmd="${cmd//||/$'\n'}"
  local c
  for c in ';' '|' '&' '(' ')' '`' '{' '}'; do cmd="${cmd//"$c"/$'\n'}"; done
  cmd="${cmd//\"/}"
  cmd="${cmd//\'/}"
  # Word splitting below must not expand a * in the command against this
  # folder.
  set -f
  while IFS= read -r seg; do
    # shellcheck disable=SC2086 # splitting the piece into words is the point
    reason="$(git_reason "$cwd" "$own" $seg)"
    [[ -z "$reason" ]] && continue
    reason="mcv: refused, $reason. You work only on your branch $own. If the task needs this, ask the user: \"$SELF\" needs-decision \"<what and why>\"."
    jq -cn --arg r "$reason" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    return 0
  done <<<"$cmd"
}

case "${1:-}" in
  --guard-git)
    is_task "${MCV_TASK:-}" || exit 0
    guard_git
    ;;

  # A hook acts only for a real worker: MCV_TASK names a task spawn created.
  # Anything else (unset, malformed, a task already removed) is not a worker.
  --contract)
    is_task "${MCV_TASK:-}" || exit 0
    # Proof that this worker's Claude loaded mcv's hooks: prompt refuses a
    # worker without it, since that worker has none of the rules below.
    tdir="$MCV_HOME/${MCV_TASK%%/*}/tasks/${MCV_TASK#*/}"
    : >"$tdir/rules-loaded" 2>/dev/null || true
    # Claude gives the session's transcript path in the hook's input; remove
    # keeps the list in the task's history. A resumed or cleared session
    # starts a new transcript, so each new path is added once. A caller with
    # a terminal for input is not Claude and sends none.
    if [[ ! -t 0 ]]; then
      tp="$(jq -r '.transcript_path // empty' 2>/dev/null || true)"
      if [[ -n "$tp" ]] && ! grep -qxF "$tp" "$tdir/transcripts" 2>/dev/null; then
        printf '%s\n' "$tp" >>"$tdir/transcripts" 2>/dev/null || true
      fi
    fi
    jq -cn --arg ctx "$(contract_text)" \
      '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}}'
    ;;

  --deny-ask)
    is_task "${MCV_TASK:-}" || exit 0
    reason="mcv workers do not use AskUserQuestion. Ask through: \"$SELF\" needs-decision \"<question>\", then end your turn and wait; the answer arrives as your next prompt."
    jq -cn --arg r "$reason" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    ;;

  --task)
    [[ $# -ge 5 && ( "$3" == answered || "$3" == pending || "$3" == amended ) ]] \
      || usage "usage: --task <project>/<id> answered|pending|amended <question-id|order-id> <text>, or pending - <text>"
    has_text "${*:5}" || usage "the answer is empty; record what the user said"
    # Only the coordinator records answers; a worker closing its own question
    # would hide it from the user.
    [[ -z "${MCV_TASK:-}" ]] || die "a worker cannot record answers; only the coordinator does"
    log="$(log_of "$2")" || exit 1
    qid="$4"
    # An order that answers no question is kept as pending under an order id
    # (o1, o2, ...) that is picked here, under the lock, so two never share one.
    if [[ "$3" == pending && "$qid" == - ]]; then
      lock_log "$log"
      n=""
      [[ ! -f "$log" ]] || n="$(cut -f3 "$log" | sed -n 's/^o\([1-9][0-9]*\)$/\1/p' | sort -n | tail -1)"
      qid="o$(( ${n:-0} + 1 ))"
      append "$log" pending "$qid" "${*:5}"
      printf '%s\n' "$qid"
      exit 0
    fi
    [[ "$qid" =~ ^[qo][1-9][0-9]*$ ]] \
      || die "id '$qid': expected a question (q1, q2, ...) or an order (o1, o2, ...); pending - queues a new order"
    lock_log "$log"
    if [[ "$qid" == o* ]]; then
      if [[ ! -f "$log" ]] || ! cut -f2,3 "$log" | grep -qxF "pending"$'\t'"$qid"; then
        die "no order $qid in task $2; queue one with pending -"
      fi
    elif [[ ! -f "$log" ]] || ! cut -f2,3 "$log" | grep -qxF "needs-decision"$'\t'"$qid"; then
      die "no question $qid in task $2"
    fi
    if [[ "$3" == amended ]]; then
      cut -f2,3 "$log" | grep -qxF "answered"$'\t'"$qid" \
        || die "question $qid in task $2 is not answered yet; record it with answered"
    else
      ! cut -f2,3 "$log" | grep -qxF "answered"$'\t'"$qid" \
        || die "question $qid in task $2 is already answered; a correction is amended"
    fi
    append "$log" "$3" "$qid" "${*:5}"
    ;;

  --journal)
    [[ $# -ge 3 ]] || usage "usage: --journal <project>[/<id>] <text>"
    has_text "${*:3}" || usage "the journal line is empty; say what happened"
    # Workers report through their own log; the journal is the coordinator's.
    [[ -z "${MCV_TASK:-}" ]] || die "a worker cannot write the journal; report with note instead"
    project="${2%%/*}"
    [[ "$project" =~ ^[a-z][a-z0-9_-]*$ ]] || die "expected <project> or <project>/<id>, got '$2'"
    task=-
    if [[ "$2" == */* ]]; then
      [[ "$2" =~ $TASK_RE ]] || die "expected <project> or <project>/<id>, got '$2'"
      task="$2"
    fi
    mkdir -p "$MCV_HOME/$project" || die "cannot create $MCV_HOME/$project"
    append "$MCV_HOME/$project/journal.log" note "$task" "${*:3}"
    ;;

  needs-decision|blocked|done|failed|note|waiting)
    [[ -n "${MCV_TASK:-}" ]] || usage "MCV_TASK not set; only an mcv worker reports status"
    [[ $# -ge 2 ]] || usage "usage: $1 <text>"
    has_text "${*:2}" || usage "$1 needs some text; say what the user should know"
    log="$(log_of "$MCV_TASK")" || exit 1
    lock_log "$log"
    # Text given without quotes comes as several arguments; keep all of it.
    if [[ "$1" == needs-decision ]]; then
      n=1
      [[ -f "$log" ]] && n=$(( $(cut -f2 "$log" | grep -cx needs-decision || true) + 1 ))
      append "$log" needs-decision "q$n" "${*:2}"
      printf 'q%d\n' "$n"
    else
      append "$log" "$1" - "${*:2}"
    fi
    ;;

  *)
    awk 'NR >= 3 && /^set -euo/ { exit } NR >= 3' "$SELF" | sed 's/^#$//; s/^# //' >&2
    exit 2
    ;;
esac
