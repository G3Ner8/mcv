#!/usr/bin/env bash
#
# mcv-watch: one stream of the events a coordinator acts on, for every worker
# of a project. Run it under Claude Code's Monitor tool: each printed line
# wakes the coordinator for a turn, so only lines worth a turn are printed.
#
# Usage:
#   mcv-watch <project>            poll every MCV_WATCH_INTERVAL seconds (default 5) until killed;
#                                  exits 1 at once if a watcher for <project> already runs
#                                  (lock: $MCV_HOME/<project>/watch.lock), unless that one
#                                  was started by the same Claude process (a conversation
#                                  before /clear): then it stops it, exit 0 there, and
#                                  says so on stderr; starts afresh, for a
#                                  coordinator that has not seen this project's events
#   mcv-watch <project> --resume   the same, going on from where the last watcher of
#                                  <project> stopped: nothing it printed is printed again
#                                  (state: $MCV_HOME/<project>/watch-state)
#   mcv-watch <project> --once     one poll, keeping state in MCV_WATCH_STATE (for tests)
#
# Printed, one line per event: "⍉ <id> · <EVENT>[ <qid>] · <text>". The mark
# and the fixed words make mcv's lines easy to find among others in a
# coordinator's session; the project is the one this watcher was started for.
#   ⍉ <id> · QUESTION <qid> · <text>   the worker asks the user (needs-decision)
#   ⍉ <id> · BLOCKED · <text>          the worker reports it cannot go on
#   ⍉ <id> · DONE · <text>             the worker reports its task finished
#   ⍉ <id> · FAILED · <text>           the worker reports its task failed
#   ⍉ <id> · WAITING · ...             it stopped at an approval or question dialog in its pane;
#                                      what the dialog shows follows, one line each
#                                      marked "  | " (the screen below its last full
#                                      rule), when it can be read; of a dialog longer
#                                      than 12 lines, the first 4 and the last 8, with
#                                      a line between saying how many are left out
#   ⍉ <id> · RESUMED · ...             it left that dialog and is working again
#   ⍉ <id> · STOPPED · ...             its turn ended with no report (see below), or a wait
#                                      it announced has lasted past the limit: read its screen
#   ⍉ <id> · DELIVER <qid> · <answer>  an answer or an order (o1, o2, ...) kept as
#                                      pending, now that the worker has stopped:
#                                      send it, then record it
#   ⍉ <id> · GONE · ...                the worker's pane is no longer there (not while
#                                      spawn is still starting it)
# A log kind this list does not name is printed in capitals the same way.
# A text longer than 400 characters goes over several lines, each later one
# marked "  …" and going on where the line above stopped (the Monitor tool
# cuts a line at about 500 characters and a notification at about 3000);
# past 2600 characters it stops and the last line says the rest is in the
# task's status.log. The Monitor tool also joins lines that come within
# 200 ms into one notification: an event that would take the lines printed
# since the last poll past 2800 characters is held back 0.4 seconds, so it
# starts a notification of its own.
# MCV_WATCH_RAW=1 prints the same events tab-separated instead, for scripts
# and tests: "<time> <project>/<id> <kind> <qid|-> <text>", where kind is a
# log kind, "deliver", "gone", or "state" with blocked, working or done (a
# stuck wait adds a fifth field, "wait").
#
# Not printed: changes to idle or unknown, and to working except from
# blocked; note and waiting lines (the status table shows them); the
# coordinator's own "answered", "amended" and "pending" lines; anything already in a
# log when the watcher
# starts, except questions that have no answered or pending line yet, which
# are printed once so a coordinator started later still sees them, and
# pending answers, which come as DELIVER once the worker has stopped.
# STOPPED is also skipped when the worker's last log line since its
# previous state event was needs-decision, blocked, done or failed, because
# that line already woke the coordinator, and when a DELIVER goes out for
# the same stop. A turn that ends with no log line, or after only a note,
# does print it: then the coordinator reads the screen. Not, though, when
# the worker owes nothing: its last report (notes and waits aside) was a
# question, a block, done or failed, and the journal shows no prompt sent
# to it since. A note after its question, or Claude compacting an idle
# worker's context, ends a turn that way (measured: 3 of 3 STOPPED in one
# run), and a wait it announces then is not timed either.
# A turn that ends right after a waiting line is the stop the worker
# announced and prints nothing; if the worker is still stopped
# MCV_WATCH_WAIT_LIMIT seconds later (default 1800; 0: never), STOPPED is
# printed once. Working again ends the wait; any report other than a note
# ends it too.
#
# A project with no tasks folder yet (nothing spawned, or a misspelt name)
# is said once on stderr; the watcher keeps running.
#
# While herdr fails, log lines are still printed and worker states wait; one
# warning goes to stderr per outage. A task whose meta cannot be read is
# skipped until it can.
#
# Environment: MCV_HOME (default ~/.claude/mcv), MCV_WATCH_INTERVAL,
# MCV_WATCH_WAIT_LIMIT, MCV_WATCH_STATE (state folder, kept as it is even
# without --resume; default $MCV_HOME/<project>/watch-state, required with
# --once), MCV_WATCH_NOW (the clock in seconds, for tests), MCV_WATCH_OWNER
# (the pid of the Claude process the watcher belongs to, found by itself
# when unset; empty: none, so it never replaces another), MCV_HERDR (the
# herdr helper; default: mcv-herdr.sh next to this file).

set -euo pipefail

MCV_HOME="${MCV_HOME:-$HOME/.claude/mcv}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
HERDR="${MCV_HERDR:-$HERE/mcv-herdr.sh}"
INTERVAL="${MCV_WATCH_INTERVAL:-5}"

usage() {
  [[ -n "${1:-}" ]] && printf 'mcv-watch: %s\n' "$1" >&2
  awk 'NR >= 3 && /^set -euo/ { exit } NR >= 3' "${BASH_SOURCE[0]}" | sed 's/^#$//; s/^# //' >&2
  exit 2
}

project="${1:-}"
[[ "$project" =~ ^[a-z][a-z0-9_-]*$ ]] || usage "expected a project name"
once="" resume=""
case "$#:${2:-}" in
  1:) ;;
  2:--once) once=1 ;;
  2:--resume) resume=1 ;;
  *) usage "unexpected arguments: ${*:2}" ;;
esac
[[ "$INTERVAL" =~ ^[0-9]+(\.[0-9]+)?$ && ! "$INTERVAL" =~ ^0+(\.0+)?$ ]] \
  || usage "MCV_WATCH_INTERVAL must be a number of seconds above 0, got '$INTERVAL'"
WAIT_LIMIT="${MCV_WATCH_WAIT_LIMIT:-1800}"
[[ "$WAIT_LIMIT" =~ ^[0-9]+$ ]] || usage "MCV_WATCH_WAIT_LIMIT must be a whole number of seconds, got '$WAIT_LIMIT'"
[[ -z "${MCV_WATCH_NOW:-}" || "$MCV_WATCH_NOW" =~ ^[0-9]+$ ]] \
  || usage "MCV_WATCH_NOW must be seconds since 1970, got '$MCV_WATCH_NOW'"
tasks="$MCV_HOME/$project/tasks"

# Print one event, given as its tab-separated raw form (see the header).
emit() {
  if [[ "${MCV_WATCH_RAW:-}" == 1 ]]; then
    printf '%s\n' "$1"
    return
  fi
  local ts task kind f4 f5 label text="" dialog=""
  IFS=$'\t' read -r ts task kind f4 f5 <<<"$1"
  case "$kind" in
    state)
      case "$f4" in
        blocked)
          label=WAITING; text="a dialog is open in its pane"
          dialog="$(dialog_of "$task")"
          [[ -z "$dialog" ]] || text="$text:" ;;
        working) label=RESUMED; text="it left the dialog and is working again" ;;
        done)
          label=STOPPED
          if [[ "$f5" == wait ]]; then
            text="it said it would wait, and is still stopped past the limit; read its screen"
          else
            text="its turn ended with no report; read its screen"
          fi ;;
        *)       label="$(printf '%s' "$f4" | tr '[:lower:]' '[:upper:]')" ;;
      esac ;;
    gone)           label=GONE; text="its pane is no longer there" ;;
    deliver)        label="DELIVER $f4"; text="$f5" ;;
    needs-decision) label="QUESTION $f4"; text="$f5" ;;
    *)              label="$(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]')"; text="$f5" ;;
  esac
  local out
  out="$(say_event "⍉ ${task#*/} · $label" "$text"; [[ -z "$dialog" ]] || printf '%s\n' "$dialog")"
  # The Monitor tool joins lines that come within 200 ms into one
  # notification and cuts that at about 3000 characters, saying nothing
  # (measured: of two 1500-character questions in one poll, the end of the
  # second was lost). An event that would not fit with those already printed
  # in this burst waits long enough to start a notification of its own.
  if (( BURST > 0 && BURST + ${#out} + 1 > BURST_MAX )); then
    sleep 0.4
    BURST=0
  fi
  printf '%s\n' "$out"
  BURST=$((BURST + ${#out} + 1))
}
# Characters printed since the last pause between polls (bytes under a C
# locale, which only makes a burst end sooner).
BURST=0
BURST_MAX=2800

# Print a header and its text. The Monitor tool cuts a line at about 500
# characters and a notification at about 3000 (measured), and a cut
# question made the coordinator read the log again. A text longer than
# LINE goes over several lines, each later one marked "  …": joined with
# nothing between, they give the text back. jq does the cutting, by
# character whatever the locale; bash would cut Thai between bytes under
# LC_ALL=C. Past MAXTEXT the text stops and the last line says where the
# rest is.
LINE=400
MAXTEXT=2600
say_event() {
  local head="$1" text="$2" cut="(cut here: the full text is in the task's status.log)"
  if (( ${#text} > LINE )) && jq -rn --arg h "$head" --arg t "$text" --arg c "$cut" \
      --argjson n "$LINE" --argjson max "$MAXTEXT" '
      ($t | length) as $len
      | (if $len > $max then $t[0:$max] else $t end) as $s
      | [range(0; ($s | length); $n) as $i | $s[$i:$i + $n]] as $p
      | ($h + " · " + $p[0]), ($p[1:][] | "  …" + .),
        (if $len > $max then "  …" + $c else empty end)' 2>/dev/null; then
    return 0
  fi
  printf '%s%s\n' "$head" "${text:+ · $text}"
}

# What the dialog of task $1 shows, one line each marked "  | ", so the
# coordinator can describe it without reading the screen (measured: one
# read for each of 28 dialogs in a run). Claude Code draws a dialog under a
# full-width rule at the bottom of the screen: the lines after the last
# such rule are taken as they are, without the dashed rules inside it, the
# pointer in front of the first answer and the key hints. Nothing when the
# screen cannot be read or has no such rule. The last 80 lines of the
# screen are read, so a tall dialog still has its rule in them.
dialog_of() {
  local screen l bare found=0
  local -a shown=()
  screen="$("$HERDR" read "$1" 80 2>/dev/null)" || return 0
  while IFS= read -r l; do
    bare="${l//─/}"
    bare="${bare//[[:space:]]/}"
    if [[ -z "$bare" && "$l" == *─* ]]; then
      found=1
      shown=()
      continue
    fi
    bare="${l//╌/}"
    bare="${bare//[[:space:]]/}"
    [[ -n "$bare" ]] || continue
    # Leading spaces, a box edge and the answer pointer are layout.
    l="${l#"${l%%[![:space:]]*}"}"
    l="${l#│}"
    l="${l#❯}"
    l="${l#"${l%%[![:space:]]*}"}"
    l="${l%"${l##*[![:space:]]}"}"
    [[ -n "$l" && "$l" != "Esc to cancel"* ]] || continue
    shown+=("$l")
  done <<<"$screen"
  (( found )) || return 0
  # A long dialog keeps both ends: the top says what it is about, the
  # bottom why it asks, the question and the answers on offer (measured on
  # 15 real dialogs: cut from the top only, 14 lost an answer line and one
  # the question). 12 lines of at most 200 characters and the line that
  # says what is left out stay inside one notification.
  local total=${#shown[@]} i=0
  for l in ${shown[@]+"${shown[@]}"}; do
    i=$((i + 1))
    if (( total > DIALOG_TOP + DIALOG_END )); then
      if (( i == DIALOG_TOP + 1 )); then
        printf '  | (%s lines of the dialog are not shown here: read its screen for them)\n' \
          "$((total - DIALOG_TOP - DIALOG_END))"
      fi
      (( i <= DIALOG_TOP || i > total - DIALOG_END )) || continue
    fi
    printf '  | %s\n' "${l:0:200}"
  done
}
DIALOG_TOP=4
DIALOG_END=8

# True when the worker of task $2 (log $1) has said its piece and been sent
# nothing since: its last report, notes and waits aside, is a question, a
# block, done or failed, and the journal has no prompt sent to it after
# that line. Such a worker owes the coordinator nothing, so a turn of its
# own that ends without a report (a note after its question, Claude
# compacting an idle session) is not a stop to look at. Times are the logs'
# own UTC stamps, which sort as text. Something the user typed into the
# worker's pane is not in the journal; they were there to see it stop.
settled() {
  local last sent
  last="$(awk -F'\t' '$2 == "needs-decision" || $2 == "blocked" || $2 == "done" || $2 == "failed" { t = $1 }
    END { print t }' "$1" 2>/dev/null || true)"
  [[ -n "$last" ]] || return 1
  sent="$(awk -F'\t' -v k="$2" '$2 == "prompt" && $3 == k && $4 ~ /^ok:/ { t = $1 } END { print t }' \
    "$MCV_HOME/${2%%/*}/journal.log" 2>/dev/null || true)"
  [[ -z "$sent" || "$sent" < "$last" ]]
}

# One poll. The state folder has one subfolder per project, so watchers of
# two projects can share it; per task it keeps one line:
#   <pane> <last state> <last change counter> <log lines read> <kind of last log line read> <gone 0|1> <owe 0|1> <delivered up to line> <waiting since>
# waiting since is the time, in seconds, of the stop that followed a waiting
# line, or 0 when the worker is not in such a wait. owe is 1 when a pending line was read but the worker's state could not be
# checked yet (herdr down); the next poll then delivers it if the worker has
# stopped. The pane names the task's current worker: a task removed and spawned again
# under the same id, even within one poll, gets a new pane and a fresh start.
poll() {
  local dir="$1/$project" first=0 agents herdr_ok=1
  mkdir -p "$dir"
  [[ -e "$dir/.started" ]] || first=1
  # A misspelt project name would otherwise watch nothing in silence.
  if (( first )) && [[ ! -d "$tasks" ]]; then
    printf 'mcv-watch: no tasks for project %s yet (%s); its events start once a worker is spawned\n' \
      "$project" "$tasks" >&2
  fi
  # The status logs do not need herdr, so their lines are still passed on
  # while herdr fails; only worker states wait. One warning per outage.
  if ! agents="$("$HERDR" agents 2>&1)"; then
    herdr_ok=0
    [[ -e "$dir/.herdr-down" ]] || printf 'mcv-watch: worker states unavailable: %s\n' "$agents" >&2
    : >"$dir/.herdr-down"
  else
    rm -f "$dir/.herdr-down"
  fi

  local f
  for f in "$dir"/*; do
    [[ -f "$f" && -f "$tasks/${f##*/}/meta" ]] || rm -f "$f"
  done

  # One timestamp per poll; forking date per task made a poll of 200 tasks
  # slower than the interval.
  local now nowsec
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  nowsec="${MCV_WATCH_NOW:-$(date +%s)}"

  local meta
  for meta in "$tasks"/*/meta; do
    [[ -f "$meta" ]] || continue
    local tdir="${meta%/meta}" id task pane log sf
    id="${tdir##*/}"
    task="$project/$id"
    # An unreadable meta (being written, or damaged) skips the task this
    # poll instead of stopping the watcher.
    pane="$(jq -r '.pane_id // empty' "$meta" 2>/dev/null || true)"
    [[ "$pane" =~ ^[^[:space:]]+$ ]] || continue
    log="$tdir/status.log"
    sf="$dir/$id"

    local spane=- prev=- prev_seq=- offset=0 lastkind=- gone=0 owe=0 dl=0 ws=0 new=1 damaged=0
    if [[ -f "$sf" ]]; then
      read -r spane prev prev_seq offset lastkind gone owe dl ws <"$sf" || true
      [[ "$owe" =~ ^[01]$ ]] || owe=0
      [[ "$dl" =~ ^[0-9]+$ ]] || dl=0
      # A state line written before waiting existed has no ninth field.
      [[ "$ws" =~ ^[0-9]+$ ]] || ws=0
      if [[ ! "$offset" =~ ^[0-9]+$ || ! "$gone" =~ ^[01]$ || -z "$lastkind" ]]; then
        damaged=1
      elif [[ "$spane" == "$pane" ]]; then
        new=0
      fi
      if (( new )); then
        prev=- prev_seq=- offset=0 lastkind=- gone=0 owe=0 dl=0 ws=0
      fi
    fi

    local lines=0
    if [[ -f "$log" ]]; then
      # A log that cannot be read just now (removed mid-poll, say) skips the
      # task this poll; it must not stop the watcher for every other task.
      lines="$(wc -l 2>/dev/null <"$log" | tr -d ' ')" && [[ "$lines" =~ ^[0-9]+$ ]] || continue
    fi
    # On the watcher's first poll, old lines are history, not events, except
    # questions still without an answer: a coordinator that starts after
    # they were asked must still see them. A question the user already
    # answered, kept as pending, is not asked again; it is owed a deliver
    # instead. A damaged state line cannot say what was read, so it is
    # handled the same way. A task first seen later is new, so its log is
    # followed from the start.
    if (( (new && first) || damaged )); then
      if (( lines > 0 )); then
        local open
        open="$(awk -F'\t' -v t="$task" '
          $2 == "needs-decision" { q[$3] = $1 "\t" t "\t" $2 "\t" $3 "\t" $4; order[++n] = $3 }
          $2 == "pending"        { p[$3] = 1 }
          $2 == "answered"       { delete q[$3]; delete p[$3] }
          END {
            for (i = 1; i <= n; i++) if ((order[i] in q) && !(order[i] in p)) { print q[order[i]]; delete q[order[i]] }
            for (k in p) { print "#owe"; exit }
          }
        ' "$log" 2>/dev/null || true)"
        if [[ "$open" == *"#owe"* ]]; then
          owe=1
          open="$(grep -vx '#owe' <<<"$open" || true)"
        fi
        if [[ -n "$open" ]]; then
          local oline
          while IFS= read -r oline; do emit "$oline"; done <<<"$open"
          lastkind=needs-decision
        fi
      fi
      offset="$lines"
    fi
    (( damaged )) && printf 'mcv-watch: %s: state was damaged; its open questions are shown again, and its log followed from now on\n' "$task" >&2
    # A log shorter than what was read was started again.
    (( lines < offset )) && offset=0
    (( lines < dl )) && dl=0

    if (( lines > offset )); then
      local ts kind qid text
      while IFS=$'\t' read -r ts kind qid text; do
        # A blank or broken line is not an event, and must not become the
        # "last kind" (an empty one would read as damaged state next poll).
        [[ -z "$kind" || "$kind" == answered || "$kind" == amended ]] && continue
        # The coordinator's own pending answer: owed back once the worker
        # stops, never printed as it is.
        if [[ "$kind" == pending ]]; then
          owe=1
          continue
        fi
        lastkind="$kind"
        # A note is for the status table and a waiting line only marks the
        # coming stop as expected: neither is worth waking the coordinator.
        # Any other report is, and it ends a wait.
        [[ "$kind" == note || "$kind" == waiting ]] && continue
        ws=0
        emit "$(printf '%s\t%s\t%s\t%s\t%s' "$ts" "$task" "$kind" "$qid" "$text")"
      done < <(tail -n +"$((offset + 1))" "$log" | head -n "$((lines - offset))")
      offset="$lines"
    fi

    local row status seq
    if (( ! herdr_ok )); then
      printf '%s %s %s %s %s %s %s %s %s\n' "$pane" "$prev" "$prev_seq" "$offset" "$lastkind" "$gone" "$owe" "$dl" "$ws" >"$sf"
      continue
    fi
    row="$(awk -F'\t' -v p="$pane" '$1 == p { print $2 " " $3; exit }' <<<"$agents")"
    if [[ -z "$row" ]]; then
      # A worker still starting (spawn's marker) that has never been seen in
      # the agent list is not gone yet.
      if [[ -e "$tdir/starting" && "$prev" == - ]]; then
        :
      else
        (( gone )) || emit "$(printf '%s\t%s\tgone\t-' "$now" "$task")"
        gone=1
      fi
    else
      gone=0
      status="${row%% *}"
      seq="${row#* }"
      # A pending answer goes back to the coordinator when the worker stops
      # (done or idle), or at once if it had already stopped when the answer
      # was recorded. done -> idle is only the output being viewed, not a
      # new stop, so it does not repeat the deliver. Each pending line is
      # delivered once (dl: log lines already delivered from): the worker's
      # turn on the delivered answer can end before the coordinator records
      # it as answered, and that stop must not send it again. A send that
      # failed is recorded as a new pending line.
      local delivered=0
      if [[ "$status" == "done" || "$status" == idle ]]; then
        local stopnow=0 pend line
        if [[ "$prev" != "done" && "$prev" != idle ]] || [[ "$status" == "done" && "$seq" != "$prev_seq" ]]; then
          stopnow=1
        fi
        if (( stopnow || owe )); then
          pend="$(awk -F'\t' -v dl="$dl" '
            $2 == "pending"  { if (!($3 in p)) order[++n] = $3; p[$3] = $4; at[$3] = NR }
            $2 == "answered" { delete p[$3] }
            END { for (i = 1; i <= n; i++) if ((order[i] in p) && at[order[i]] > dl) print order[i] "\t" p[order[i]] }
          ' "$log" 2>/dev/null || true)"
          dl="$lines"
          if [[ -n "$pend" ]]; then
            while IFS= read -r line; do
              emit "$(printf '%s\t%s\tdeliver\t%s' "$now" "$task" "$line")"
            done <<<"$pend"
            delivered=1
          fi
        fi
      fi
      owe=0
      # A new state, or the same state with a moved counter (a whole turn
      # happened between two polls), counts as a transition.
      if [[ ( "$status" == blocked || "$status" == "done" ) && ( "$status" != "$prev" || "$seq" != "$prev_seq" ) ]]; then
        if (( delivered )); then
          :
        elif [[ "$status" == "done" ]] && [[ "$lastkind" =~ ^(needs-decision|blocked|done|failed)$ ]]; then
          :
        elif [[ "$status" == "done" ]] && settled "$log" "$task"; then
          # Nothing was asked of it since its last report: neither a stop
          # to read nor a wait to time.
          :
        elif [[ "$status" == "done" && "$lastkind" == waiting ]]; then
          # The stop the worker announced: count the wait from here.
          ws="$nowsec"
        else
          emit "$(printf '%s\t%s\tstate\t%s' "$now" "$task" "$status")"
        fi
        lastkind=-
      elif [[ "$status" == working ]]; then
        # Woken by its background work: this wait is over. If it waits
        # again, it says so again.
        ws=0
      fi
      # A wait that lasts past the limit is a worker stuck or a job that
      # never reports back; said once, then the wait is forgotten.
      if (( ws > 0 && WAIT_LIMIT > 0 && nowsec - ws >= WAIT_LIMIT )) \
          && [[ "$status" == "done" || "$status" == idle ]]; then
        emit "$(printf '%s\t%s\tstate\tdone\twait' "$now" "$task")"
        ws=0
      fi
      # The user answered a dialog in the worker's pane: without this line
      # the coordinator, last told it was blocked, would go on asking the
      # user to approve something that is no longer on the screen.
      if [[ "$prev" == blocked && "$status" == working ]]; then
        emit "$(printf '%s\t%s\tstate\tworking' "$now" "$task")"
      fi
      prev="$status"
      prev_seq="$seq"
    fi

    printf '%s %s %s %s %s %s %s %s %s\n' "$pane" "$prev" "$prev_seq" "$offset" "$lastkind" "$gone" "$owe" "$dl" "$ws" >"$sf"
  done

  touch "$dir/.started"
}

if [[ -n "$once" ]]; then
  [[ -n "${MCV_WATCH_STATE:-}" ]] || usage "--once needs MCV_WATCH_STATE, the folder that keeps state between polls"
  mkdir -p "$MCV_WATCH_STATE"
  poll "$MCV_WATCH_STATE"
  exit 0
fi

# One watcher per project. A second one would print every event twice, and
# a coordinator can lose track of the one it started (a context compaction,
# say). The lock holds the watcher's pid; it counts as held only while that
# pid is still an mcv-watch, so a crashed watcher's lock, or its pid reused
# by another program, does not block the next one.
lock="$MCV_HOME/$project/watch.lock"
mkdir -p "$MCV_HOME/$project"
holder() {
  local pid
  pid="$(cat "$lock/pid" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && ps -p "$pid" -o command= 2>/dev/null | grep -q mcv-watch && printf '%s' "$pid"
}
# The Claude process this watcher runs under: the nearest ancestor whose
# command is `claude` (measured: a Monitor command's parent shell is its
# child). Nothing when there is none, or when it cannot be told.
# MCV_WATCH_OWNER, even empty, replaces the search; the tests use it.
claude_ancestor() {
  local p=$$ c i=0
  while (( i < 8 )); do
    i=$((i + 1))
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    [[ "$p" =~ ^[0-9]+$ ]] && (( p > 1 )) || return 0
    c="$(ps -o command= -p "$p" 2>/dev/null || true)"
    c="${c%% *}"
    if [[ "${c##*/}" == claude ]]; then
      printf '%s' "$p"
      return 0
    fi
  done
}
owner="${MCV_WATCH_OWNER-$(claude_ancestor)}"
refuse_if_held() {
  local pid i
  # A watcher starting this instant has made the lock but not yet written
  # its pid.
  [[ -s "$lock/pid" ]] || sleep 1
  if pid="$(holder)"; then
    # /clear starts a new conversation in the same Claude process and
    # leaves the old one's watcher running for up to 30 minutes, lock and
    # all (measured: a task waited 22 minutes for it). That watcher is this
    # session's own: stop it and carry on. It exits 0 on TERM, so its
    # Monitor reports an end, not a failure; what it had read is in the
    # state folder. One of another Claude process, or of unknown origin,
    # is somebody else's.
    if [[ -n "$owner" && "$(cat "$lock/owner" 2>/dev/null || true)" == "$owner" ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      i=0
      while (( i < 25 )) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.2
        i=$((i + 1))
      done
      if ! kill -0 "$pid" 2>/dev/null; then
        printf 'mcv-watch: replaced the earlier watcher of this Claude session (pid %s), left running by /clear\n' "$pid" >&2
        return 0
      fi
    fi
    printf 'mcv-watch: a watcher for %s is already running (pid %s); use that one, or if no session is reading it, stop it with: kill %s\n' \
      "$project" "$pid" "$pid" >&2
    exit 1
  fi
}
# Taking over a stale lock is two steps, remove it and make a new one, so two
# watchers that both found it stale could each remove the other's new lock
# and both run. Only the holder of a second lock, watch.lock.takeover, may
# remove the first, and it looks at the holder again first, since the lock
# may have been taken over since. It writes its pid before letting go, so the
# next one in sees a live holder and refuses. A watcher that finds the
# takeover lock held waits and starts over. One left by a watcher killed
# mid-takeover, which takes well under a second, is cleared after 5 seconds.
takeover="$lock.takeover"
waited=0
until mkdir "$lock" 2>/dev/null; do
  refuse_if_held
  if mkdir "$takeover" 2>/dev/null; then
    trap 'rmdir "$takeover" 2>/dev/null' EXIT
    [[ ! -e "$lock" ]] || { refuse_if_held; rm -rf "$lock"; }
    if mkdir "$lock" 2>/dev/null; then
      printf '%s\n' "$owner" >"$lock/owner"
      printf '%s\n' "$$" >"$lock/pid"
      rmdir "$takeover"
      trap - EXIT
      break
    fi
    rmdir "$takeover"
    trap - EXIT
    continue
  fi
  sleep 0.2
  waited=$((waited + 1))
  (( waited < 25 )) || { rmdir "$takeover" 2>/dev/null; waited=0; }
done
printf '%s\n' "$owner" >"$lock/owner"
printf '%s\n' "$$" >"$lock/pid"

# The state outlives the watcher, so that one restarted with --resume after
# the Monitor tool ended it goes on from the lines it had read instead of
# showing open questions again. A watcher started without --resume is a new
# coordinator's: it starts from nothing, and shows what is still open.
state="${MCV_WATCH_STATE:-$MCV_HOME/$project/watch-state}"
[[ -n "$resume" || -n "${MCV_WATCH_STATE:-}" ]] || rm -rf "$state"
# The Monitor tool stops the watcher with a signal, usually mid-sleep.
trap 'exit 0' INT TERM
trap 'rm -rf "$lock"' EXIT
mkdir -p "$state"
while true; do
  poll "$state"
  # Sleep in the background and wait for it: bash runs a trap only between
  # commands, so a foreground sleep held a stop signal for up to INTERVAL.
  sleep "$INTERVAL" &
  wait $! || true
  # That pause ended the burst of lines, unless it is shorter than the
  # Monitor tool's 200 ms (an interval set for a test, say).
  [[ "$INTERVAL" =~ ^0*\.[0-3] ]] || BURST=0
done
